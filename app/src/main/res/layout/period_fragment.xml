<?xml version="1.0" encoding="utf-8"?>
<!-- This is a file to try and migrate the period view into
it's own file to be called upon rather than within a hidden layout
Must have a seleected date shown
THe calendar with the period cycle days/expected days selected and colored
The summary box to show the period progress by days to end/ days to next
A button to add the current days period information
Default all days to having no actual period
There should only be 1 expecting week,
    that is updated by the start/end date of the latest period cycle
The add button should replace the summary box with it's own panel
    The panel should have a x for close
    drop down menu of the flow enums
    A edittext to add notes for cramps

    RESERVE COLORS OF RED HUES MOSTLY FOR PERIODS (INCLUDING A BROWNISH RED)
-->

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:calendar="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PeriodFragment"
    >
    <TextView
        android:id="@+id/idTVDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/calendar_date"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        />

    <!-- Add CalendarView to display the Calendar -->
    <com.kizitonwose.calendar.view.CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        calendar:cv_dayViewResource="@layout/calendar_day_layout"
        android:layout_below="@id/idTVDate"
        android:layout_marginTop="30dp"
        calendar:cv_daySize="seventhWidth"
        />

    <LinearLayout
        android:id="@+id/periodSummaryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/calendarView"
        >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/periodSummaryList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="16dp"
            android:clipToPadding="false"
            android:padding="12dp" />
        <Button
            android:id="@+id/addPeriodButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:text="@string/action_add"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/periodAddNewPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/calendarView"
        android:visibility="gone"
        >
        <Button
            android:id="@+id/closePeriodButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:text="@string/action_close"
            />
        <TextView
            android:id="@+id/flowPrompter"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:hint="@string/period_flow_prompter"
            />
        <Spinner
            android:id="@+id/flowSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
        />

        <EditText
            android:id="@+id/periodNotesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:hint="@string/notes_prompter"
            android:inputType="text"
            />

        <Button
            android:id="@+id/addPeriodLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/add_period_text"
            />

    </LinearLayout>
</RelativeLayout>
