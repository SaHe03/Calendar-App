<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:calendar="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainOverviewFragment"
    >
    <!--text view for displaying the selected date
        Blue is an appointment color
    -->
    <TextView
        android:id="@+id/idTVDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="Current Date"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        />

    <!-- Add CalendarView to display the Calendar -->
    <com.kizitonwose.calendar.view.CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        calendar:cv_dayViewResource="@layout/calendar_day_layout"
        android:layout_below="@id/idTVDate"
        android:layout_marginTop="30dp"
        calendar:cv_daySize="seventhWidth"
        />

    <LinearLayout
        android:id="@+id/habitSummaryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/calendarView"
        >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/habitSummaryText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="16dp"
            android:padding="12dp"
            android:gravity="start"
            android:textColor="@color/black"
            android:textSize="16sp" />
        <CheckBox
            android:id="@+id/habitCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            />
        <Button
            android:id="@+id/addNewHabitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:text="+"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/habitAddNewPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/calendarView"
        android:visibility="gone"
        >
        <Button
            android:id="@+id/closeHabitButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:text="X"
            />
        <EditText
            android:id="@+id/habitTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:hint="Habit Name?"
            android:inputType="text"
            />
        <EditText
            android:id="@+id/habitFrequencyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:hint="frequency?"
            android:inputType="number"
            />
        <Button
            android:id="@+id/confirmHabitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Add new habit"
            />

    </LinearLayout>
</RelativeLayout>