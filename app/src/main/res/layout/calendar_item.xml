<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:maxHeight="120dp"
    android:padding="12dp"
    android:focusable="true">

    <CheckBox
        android:id="@+id/itemCheckBox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clickable="true"
        />

    <TextView
        android:id="@+id/itemTextName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Item Title"
        app:layout_constraintStart_toEndOf="@id/itemCheckBox"
        app:layout_constraintEnd_toStartOf="@id/itemEditButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        android:clickable="true"
        />

    <TextView
        android:id="@+id/itemTextNotes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/itemEditButton"
        app:layout_constraintStart_toStartOf="@id/itemTextName"
        app:layout_constraintTop_toBottomOf="@id/itemTextName" />

    <Button
        android:id="@+id/itemEditButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:visibility="gone"
        android:text="Edit"
        app:layout_constraintEnd_toStartOf="@id/itemDeleteButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="8dp"
        />

    <Button
        android:id="@+id/itemDeleteButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:visibility="gone"
        android:text="Delete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>